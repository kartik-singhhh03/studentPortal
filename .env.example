# Copy this file to create your local environment:
#   cp .env.example .env
#
# Never commit .env or .env.local — they are gitignored.
# Replace placeholders with values from the Neon Console → Connect.

# Pooled Neon connection (app runtime via PrismaNeon / @prisma/adapter-neon)
DATABASE_URL="postgresql://USER:PASSWORD@ep-XXXX-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Direct (unpooled) Neon connection — Prisma Migrate / CLI only
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-XXXX.REGION.aws.neon.tech/neondb?sslmode=require"

# Maximum CSV upload size in bytes (5 MiB default)
MAX_UPLOAD_BYTES=5242880
